msgstr "はい"

#: ebook_audiobook/checks.py:180
msgid "no"
msgstr "いいえ"

#: ebook_audiobook/checks.py:182
msgid ""
"  — this PyTorch predates 2.9 and has no kernels for the newest GPUs; re-"
