#: ebook_audiobook/device.py:85
#, python-format
msgid "%(device)s — %(note)s"
msgstr "%(device)s — %(note)s"

#: ebook_audiobook/device.py:170
#, python-format
msgid "only %(gb)s GB of VRAM; if it runs out mid-render the job continues on the CPU"
msgstr ""
"seulement %(gb)s Go de VRAM ; si elle vient à manquer en cours de narration, le "
"travail continue sur le CPU"

#: ebook_audiobook/device.py:179
#, python-format
msgid "%(arch)s works here without %(env)s"
msgstr "%(arch)s fonctionne ici sans %(env)s"

#: ebook_audiobook/device.py:193
#, python-format
msgid ""
"ROCm is installed but can't use this Radeon. Two usual causes: the card's "
"architecture isn't on ROCm's supported list — try setting %(env)s (10.3.0 for RX "
"6000, 11.0.0 for RX 7000) before starting — or the amdgpu kernel driver is older than"
" ROCm 6.4 needs, which a system update fixes. Running on the CPU meanwhile"
msgstr ""
"ROCm est installé mais ne peut pas utiliser cette Radeon. Deux causes habituelles : "
"l'architecture de la carte n'est pas dans la liste prise en charge par ROCm — essayez"
" de définir %(env)s (10.3.0 pour les RX 6000, 11.0.0 pour les RX 7000) avant de "
"démarrer — ou le pilote noyau amdgpu est plus ancien que ce que ROCm 6.4 demande, ce "
"qu'une mise à jour du système corrige. En attendant, le travail se fait sur le CPU"

#: ebook_audiobook/device.py:227
msgid ""
"Metal CPU fallback is off, so an unsupported operation could stop a render; set "
"PYTORCH_ENABLE_MPS_FALLBACK=1"
msgstr ""
"Le repli CPU de Metal est désactivé : une opération non prise en charge pourrait "
"arrêter une narration ; définissez PYTORCH_ENABLE_MPS_FALLBACK=1"

#: ebook_audiobook/device.py:236
msgid "much slower than a GPU — expect a long render"
msgstr "beaucoup plus lent qu'un GPU — prévoyez une longue narration"

#: ebook_audiobook/device.py:250
msgid "PyTorch isn't installed, so nothing can render yet"
msgstr "PyTorch n'est pas installé, rien ne peut donc encore être narré"

#: ebook_audiobook/device.py:262
#, python-format
msgid ""
"%(env)s=%(forced)s was requested but no usable %(forced)s device was found, so this "
"is running on the CPU"
msgstr ""
"%(env)s=%(forced)s a été demandé mais aucun périphérique %(forced)s utilisable n'a "
"été trouvé ; le travail se fait donc sur le CPU"

#: ebook_audiobook/device.py:271
#, python-format
msgid "%(env)s=%(forced)s isn't one of %(valid)s — ignored"
msgstr "%(env)s=%(forced)s ne fait pas partie de %(valid)s — ignoré"

