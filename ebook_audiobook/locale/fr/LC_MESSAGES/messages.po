#: ebook_audiobook/checks.py:142
msgid ""
"  PyTorch stopped building for Intel Macs after 2.2.2, so the speech\n"
"  engine can't be installed on this Mac. Importing and reading books\n"
"  still works; rendering needs an Apple Silicon Mac, Windows or Linux."
msgstr ""
"  PyTorch ne compile plus pour les Mac Intel depuis la 2.2.2, le moteur\n"
"  vocal ne peut donc pas être installé sur ce Mac. Importer et lire des livres\n"
"  fonctionne toujours ; la narration demande un Mac Apple Silicon, Windows ou Linux."

#: ebook_audiobook/checks.py:162
msgid "tts engine (fake)"
msgstr "moteur vocal (factice)"

#: ebook_audiobook/checks.py:162
msgid "no dependencies"
msgstr "aucune dépendance"

#: ebook_audiobook/checks.py:167 ebook_audiobook/checks.py:186
msgid "tts engine (chatterbox)"
msgstr "moteur vocal (chatterbox)"

#: ebook_audiobook/checks.py:168
msgid "not installed — you can import books, but not render audio"
msgstr "non installé — vous pouvez importer des livres, mais pas produire d'audio"

#: ebook_audiobook/checks.py:180
#, python-format
msgid "torch %(torch)s, chatterbox=%(cb)s, running on %(device)s"
msgstr "torch %(torch)s, chatterbox=%(cb)s, sur %(device)s"

#: ebook_audiobook/checks.py:180
msgid "yes"
msgstr "oui"

#: ebook_audiobook/checks.py:180
msgid "no"
msgstr "non"

#: ebook_audiobook/checks.py:182
msgid ""
"  — this PyTorch predates 2.9 and has no kernels for the newest GPUs; re-run the "
"installer to update it"
msgstr ""
"  — ce PyTorch est antérieur à la 2.9 et n'a pas de noyaux pour les GPU les plus "
"récents ; relancez l'installateur pour le mettre à jour"

#: ebook_audiobook/checks.py:203
