msgstr "%(device)s — %(note)s"

#: ebook_audiobook/device.py:170
#, python-format
msgid ""
"only %(gb)s GB of VRAM; if it runs out mid-render the job continues on "
"the CPU"
msgstr ""
"solo %(gb)s GB de VRAM; si se agota durante la generación, el trabajo "
"continúa en la CPU"

#: ebook_audiobook/device.py:179
#, python-format
msgid "%(arch)s works here without %(env)s"
msgstr "%(arch)s funciona aquí sin %(env)s"

#: ebook_audiobook/device.py:193
#, python-format
msgid ""
"ROCm is installed but can't use this Radeon. Two usual causes: the card's"
" architecture isn't on ROCm's supported list — try setting %(env)s "
"(10.3.0 for RX 6000, 11.0.0 for RX 7000) before starting — or the amdgpu "
"kernel driver is older than ROCm 6.4 needs, which a system update fixes. "
"Running on the CPU meanwhile"
msgstr ""
"ROCm está instalado pero no puede usar esta Radeon. Dos causas "
"habituales: la arquitectura de la tarjeta no está en la lista compatible "
"de ROCm — prueba a definir %(env)s (10.3.0 para las RX 6000, 11.0.0 para "
"las RX 7000) antes de arrancar — o el controlador amdgpu del núcleo es "
"más antiguo de lo que ROCm 6.4 necesita, algo que se soluciona "
"actualizando el sistema. Mientras tanto se usa la CPU"

#: ebook_audiobook/device.py:227
msgid ""
"Metal CPU fallback is off, so an unsupported operation could stop a "
"render; set PYTORCH_ENABLE_MPS_FALLBACK=1"
msgstr ""
"El respaldo de CPU de Metal está desactivado, así que una operación no "
"admitida podría detener la generación; define "
"PYTORCH_ENABLE_MPS_FALLBACK=1"

#: ebook_audiobook/device.py:236
msgid "much slower than a GPU — expect a long render"
msgstr "mucho más lento que una GPU — la generación tardará bastante"

#: ebook_audiobook/device.py:250
msgid "PyTorch isn't installed, so nothing can render yet"
msgstr "PyTorch no está instalado, así que todavía no se puede generar nada"

#: ebook_audiobook/device.py:262
#, python-format
msgid ""
"%(env)s=%(forced)s was requested but no usable %(forced)s device was "
"found, so this is running on the CPU"
msgstr ""
"Se pidió %(env)s=%(forced)s pero no se encontró ningún dispositivo "
"%(forced)s utilizable, así que esto se ejecuta en la CPU"

#: ebook_audiobook/device.py:271
#, python-format
msgid "%(env)s=%(forced)s isn't one of %(valid)s — ignored"
msgstr "%(env)s=%(forced)s no es uno de %(valid)s — se ignora"

