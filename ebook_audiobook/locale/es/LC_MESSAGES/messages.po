msgstr "torch %(torch)s, chatterbox=%(cb)s, en %(device)s"

#: ebook_audiobook/checks.py:180
msgid "yes"
msgstr "sí"

#: ebook_audiobook/checks.py:180
msgid "no"
msgstr "no"

#: ebook_audiobook/checks.py:182
msgid ""
"  — this PyTorch predates 2.9 and has no kernels for the newest GPUs; re-"
"run the installer to update it"
msgstr ""
"  — este PyTorch es anterior a la 2.9 y no tiene kernels para las GPU más"
" recientes; vuelve a ejecutar el instalador para actualizarlo"

