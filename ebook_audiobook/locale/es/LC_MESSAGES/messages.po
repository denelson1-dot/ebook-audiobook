#: ebook_audiobook/worker.py:170
msgid ""
"KFX (newer Kindle) isn't supported directly. Open it in Calibre and "
"convert/export it to EPUB, then import the EPUB."
msgstr ""
"KFX (Kindle reciente) no es compatible directamente. Ábrelo en Calibre, "
"conviértelo o expórtalo a EPUB e importa ese EPUB."

#: ebook_audiobook/worker.py:172
msgid ""
"This is a KFX-era Kindle file. Convert it to EPUB in Calibre first, then "
"import the EPUB."
msgstr ""
"Este es un archivo Kindle de la época KFX. Conviértelo antes a EPUB en "
"Calibre e importa el EPUB."

#: ebook_audiobook/worker.py:174
msgid ""
"An .acsm file is an Adobe download token, not the book itself. Open it in"
" Adobe Digital Editions or Calibre to fetch the actual book, then import "
"that."
msgstr ""
"Un archivo .acsm es un vale de descarga de Adobe, no el libro en sí. "
"Ábrelo en Adobe Digital Editions o en Calibre para obtener el libro real "
"e impórtalo después."

#: ebook_audiobook/worker.py:177
msgid "Old Palm/PDB ebooks aren't supported. Convert it to EPUB in Calibre first."
msgstr ""
"Los libros antiguos de Palm/PDB no son compatibles. Conviértelo antes a "
"EPUB en Calibre."

#: ebook_audiobook/worker.py:198
#, python-format
msgid "“%(ext)s” files"
msgstr "archivos «%(ext)s»"

#: ebook_audiobook/worker.py:198
msgid "files with no extension"
msgstr "archivos sin extensión"

#: ebook_audiobook/worker.py:200
#, python-format
msgid ""
"%(kind)s aren't supported. Supported formats: %(formats)s. For best "
"results, convert your book to EPUB in Calibre first."
msgstr ""
"%(kind)s no son compatibles. Formatos admitidos: %(formats)s. Para "
"obtener el mejor resultado, convierte antes tu libro a EPUB en Calibre."

#: ebook_audiobook/worker.py:287
#, python-format
msgid ""
"This book is in %(language)s. Narrating it in %(language)s needs the "
