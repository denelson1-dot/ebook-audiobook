#: ebook_audiobook/narration_langs.py:313 ebook_audiobook/web/app.py:1384
msgid ""
"The speech engine isn't installed, so there is nothing to add a language "
"to. Install it first (re-run the installer)."
msgstr ""
"El motor de voz no está instalado, así que no hay a qué añadir un idioma."
" Instálalo primero (vuelve a ejecutar el instalador)."

#: ebook_audiobook/narration_langs.py:329
msgid ""
"Couldn't reach huggingface.co. You're offline, a firewall is in the way, "
"or HF_HUB_OFFLINE is set. Everything downloaded so far is kept; try again"
" and it resumes."
msgstr ""
"No se pudo conectar con huggingface.co. Estás sin conexión, hay un "
"cortafuegos de por medio o HF_HUB_OFFLINE está definido. Lo descargado "
"hasta ahora se conserva; inténtalo de nuevo y continuará."

#: ebook_audiobook/narration_langs.py:335
msgid ""
"The disk filled up while downloading. Everything downloaded so far is "
"kept; free some space and try again — it resumes."
msgstr ""
"El disco se llenó durante la descarga. Lo descargado hasta ahora se "
"conserva; libera espacio e inténtalo de nuevo — continuará."

#: ebook_audiobook/narration_langs.py:337
#, python-format
msgid "The download failed: %(e)s"
msgstr "La descarga falló: %(e)s"

#: ebook_audiobook/power.py:56
msgid "Full speed"
msgstr "A toda velocidad"

#: ebook_audiobook/power.py:57
msgid "Balanced"
msgstr "Equilibrado"

#: ebook_audiobook/power.py:58
msgid "Quiet / background"
msgstr "Silencioso / en segundo plano"

#: ebook_audiobook/power.py:62
msgid "Use everything available. Fastest, and the machine will be busy."
msgstr "Usa todo lo disponible. Lo más rápido, y el equipo estará ocupado."

#: ebook_audiobook/power.py:63
#, python-format
msgid "Leave room to keep working. Roughly 10–25%% slower."
msgstr ""
"Deja margen para seguir trabajando. Aproximadamente entre un 10 y un 25 "
"%% más lento."

#: ebook_audiobook/power.py:64
msgid ""
"Stay out of the way — fewer cores, cooler, quieter fans. Roughly 2x "
"slower."
msgstr ""
"Sin molestar — menos núcleos, menos calor, ventiladores más silenciosos. "
"Aproximadamente 2 veces más lento."

#: ebook_audiobook/storage.py:245
msgid "Being narrated right now — these files are in use."
msgstr "Se está narrando ahora mismo — estos archivos están en uso."

#: ebook_audiobook/storage.py:252
msgid ""
"Finished — the audiobook is written and these are only a re-render "
"shortcut."
msgstr ""
"Terminado — el audiolibro ya está escrito y esto solo es un atajo para "
"regenerarlo."

#: ebook_audiobook/storage.py:256
msgid ""
"Nothing narrated yet — this is only a preview and a working copy of the "
"book."
msgstr ""
"Todavía no se ha narrado nada — esto solo es una vista previa y una copia"
" de trabajo del libro."

#: ebook_audiobook/storage.py:272
msgid "Only the audio from a preview — a few seconds' work to make again."
msgstr ""
"Solo el audio de una vista previa — unos segundos de trabajo para "
"rehacerlo."

#: ebook_audiobook/storage.py:275
#, python-format
msgid ""
"Keeping these lets it carry on from where it stopped. Delete them and "
"%(rendered)s of %(total)s sections are narrated again."
msgstr ""
"Conservarlos permite continuar desde donde se detuvo. Si los borras, se "
"volverán a narrar %(rendered)s de %(total)s secciones."

#: ebook_audiobook/storage.py:278
#, python-format
msgid ""
"Stopped before the audiobook was written. Deleting means narrating "
"%(rendered)s sections again."
msgstr ""
"Se detuvo antes de escribir el audiolibro. Borrarlos supone narrar de "
"nuevo %(rendered)s secciones."

#: ebook_audiobook/tools.py:184
msgid ""
"ffmpeg is required to build audio files but no usable copy was found. It "
"normally installs automatically with this app; reinstalling should fix "
"it, or install ffmpeg yourself:"
msgstr ""
"ffmpeg es necesario para crear archivos de audio, pero no se encontró "
"ninguna copia utilizable. Normalmente se instala junto con esta "
"aplicación; reinstalarla debería bastar, o puedes instalar ffmpeg tú "
"mismo:"

#: ebook_audiobook/tools.py:263
msgid ""
"Calibre isn't installed — its 'ebook-convert' command is what reads your "
"ebook. Install Calibre, then try again:"
msgstr ""
"Calibre no está instalado — su comando «ebook-convert» es lo que lee tu "
"libro. Instala Calibre y vuelve a intentarlo:"

#: ebook_audiobook/update.py:111
msgid "No published releases yet."
msgstr "Todavía no hay versiones publicadas."

#: ebook_audiobook/update.py:113
#, python-format
msgid "GitHub rate-limited the version check. Try again later, or see %(url)s"
msgstr ""
"GitHub limitó la comprobación de versión. Inténtalo más tarde o consulta "
"%(url)s"

#: ebook_audiobook/update.py:114
#, python-format
msgid "GitHub returned HTTP %(code)s for the version check."
msgstr "GitHub devolvió HTTP %(code)s en la comprobación de versión."

#: ebook_audiobook/update.py:116
#, python-format
msgid ""
"Couldn't reach GitHub to check for updates (%(e)s). You're offline, or a "
"firewall is in the way."
msgstr ""
"No se pudo conectar con GitHub para buscar actualizaciones (%(e)s). Estás"
" sin conexión o hay un cortafuegos de por medio."

#: ebook_audiobook/update.py:119
msgid "GitHub's reply wasn't valid JSON."
msgstr "La respuesta de GitHub no era JSON válido."

#: ebook_audiobook/update.py:123
msgid "GitHub's reply had no release tag."
msgstr "La respuesta de GitHub no incluía ninguna etiqueta de versión."

#: ebook_audiobook/update.py:176
#, python-format
msgid "%(latest)s is available (you have %(current)s)."
msgstr "%(latest)s está disponible (tienes la %(current)s)."

#: ebook_audiobook/update.py:182
#, python-format
msgid ""
"You're on %(current)s, ahead of the latest release (%(latest)s) — an "
"unreleased build."
msgstr ""
"Tienes la %(current)s, más reciente que la última versión publicada "
"(%(latest)s) — una compilación sin publicar."

#: ebook_audiobook/update.py:183
#, python-format
msgid "You're on the latest version (%(current)s)."
msgstr "Tienes la última versión (%(current)s)."

