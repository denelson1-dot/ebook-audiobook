#!/usr/bin/env bash
# Launch the web UI from a source checkout, without activating the virtualenv.
# Installed copies just use the `ebook-audiobook` command instead.
set -euo pipefail
cd "$(dirname "$0")"

PY=".venv/bin/python"
if [ ! -x "$PY" ]; then
  echo "No virtualenv found at .venv/. Set one up first:" >&2
  echo "  python3 -m venv .venv && .venv/bin/pip install -e '.[dev]'" >&2
  echo "(see CONTRIBUTING.md)" >&2
  exit 1
fi

exec "$PY" -m ebook_audiobook.cli web "$@"
